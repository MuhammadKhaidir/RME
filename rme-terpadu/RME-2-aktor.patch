@@ -22,7 +22,29 @@
   store.init = function () {
     db = ui.storage.get(App.config.storageKey, null);
     if (!db || db.version !== 1) {
       db = App.seed.generate(new Date());
       persist();
     }
+
+    // Satukan role lama agar data localStorage pengguna sebelumnya tetap bisa dipakai.
+    const roleMap = {
+      admin: 'petugas_rme',
+      pendaftaran: 'petugas_rme',
+      rm: 'petugas_rme',
+      klinisi: 'tenaga_medis',
+    };
+    let migrated = false;
+    (db.users || []).forEach((u) => {
+      if (roleMap[u.role] && roleMap[u.role] !== u.role) {
+        u.role = roleMap[u.role];
+        migrated = true;
+      }
+    });
+    (db.audit || []).forEach((entry) => {
+      if (roleMap[entry.role] && roleMap[entry.role] !== entry.role) {
+        entry.role = roleMap[entry.role];
+        migrated = true;
+      }
+    });
+    if (migrated) persist();
   };
